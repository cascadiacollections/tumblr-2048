# Package manager configuration
# This project supports both npm and yarn

# NPM settings
# Avoid auto-conversion of package-lock.json
package-lock=true

# Use exact versions by default
save-exact=false

# Don't save devDependencies by default
save-dev=false

# Increase timeout for slow connections
fetch-timeout=60000

# Use faster installation with legacy peer deps handling
legacy-peer-deps=false

# Display progress indicator
progress=true

# Use npm registry (explicit)
registry=https://registry.npmjs.org/

# Optional: Enable engine-strict to enforce engine requirements
engine-strict=true

# Fund message control (optional, set to false to suppress)
fund=true

# Update notifier
update-notifier=true
