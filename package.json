{
  "name": "tumblr-2048",
  "version": "1.0.0",
  "description": "2048 game using the tumblr API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:pug",
    "build:pug": "pug src/views -o . --pretty",
    "build:pug:watch": "pug src/views -o . --pretty --watch",
    "preview": "vite preview",
    "serve": "http-server -c-1 -p 8080",
    "start": "npm run dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,html,css,md,pug}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css,md,pug}\"",
    "validate": "npm run format:check && npm run lint && npm run test:run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascadiacollections/tumblr-2048.git"
  },
  "keywords": [
    "Tumblr",
    "2048",
    "game",
    "cat-gifs"
  ],
  "author": "Kevin T. Coughlin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cascadiacollections/tumblr-2048/issues"
  },
  "homepage": "https://github.com/cascadiacollections/tumblr-2048#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.57.0",
    "@prettier/plugin-pug": "^3.4.2",
    "@types/jquery": "^3.5.31",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/ui": "^4.0.14",
    "concurrently": "^9.2.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "prettier": "^3.3.3",
    "pug": "^3.0.3",
    "pug-cli": "^1.0.0-alpha6",
    "vite": "^7.2.4",
    "vite-plugin-pug": "^0.4.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  }
}
