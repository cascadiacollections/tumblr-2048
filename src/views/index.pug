doctype html
html.progrecss.mock.fixed.staggered.white(data-progrecss='0', lang='en')
  head
    meta(charset='utf-8')
    title 2048 Cat GIFs powered by Tumblr API
    meta(name='description', content='Play 2048 with adorable cat GIFs from Tumblr')
    link(
      href='node_modules/modern-normalize/modern-normalize.css',
      rel='stylesheet',
      type='text/css'
    )
    link(rel='stylesheet', href='style/main.css')
    link(rel='shortcut icon', href='favicon.ico')
    link(rel='apple-touch-icon', href='meta/apple-touch-icon.png')
    meta(name='theme-color', content='#ffffff')

  body
    .container
      .heading
        h1.title 2048
        .scores-container
          .score-container 0
          .best-container 0
        p.game-intro Join the numbers and get to the
          |
          strong 2048 tile!

      .game-container
        .game-message(role='alert', aria-live='assertive', aria-atomic='true')
          p
          .lower
            a.keep-playing-button Keep going
            a.retry-button Try again

        .grid-container(role='grid', aria-label='2048 game board')
          - for (let row = 0; row < 4; row++)
            .grid-row(role='row')
              - for (let col = 0; col < 4; col++)
                .grid-cell(role='gridcell')

        .tile-container(aria-live='polite', aria-atomic='false')

      p.game-explanation
        strong.important How to play:
        |
        | Use your
        strong arrow keys
        |
        | to move the tiles. When two tiles with the same number touch, they
        strong merge into one!

      hr
      p
        | Created by
        a(href='http://gabrielecirulli.com', target='_blank') Gabriele Cirulli.
        |
        | Based on
        a(href='https://itunes.apple.com/us/app/1024!/id823499224', target='_blank') 1024 by Veewo Studio
        |
        | and conceptually similar to
        a(href='http://asherv.com/threes/', target='_blank') Threes by Asher Vollmer.
      p
        | Cat GIFs from
        a(href='http://tumblr.com', target='_blank') Tumblr.

    //- Scripts
    script(type='module').
      // Firebase v12 modular imports
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/12.6.0/firebase-app.js';
      import { getAnalytics } from 'https://www.gstatic.com/firebasejs/12.6.0/firebase-analytics.js';
      import { getPerformance } from 'https://www.gstatic.com/firebasejs/12.6.0/firebase-performance.js';

      const firebaseConfig = {
        apiKey: 'AIzaSyDTnqseSgb4PRAAqu33scobYL-6bI6F61E',
        authDomain: 'tumblr2048-a96a4.firebaseapp.com',
        projectId: 'tumblr2048-a96a4',
        storageBucket: 'tumblr2048-a96a4.appspot.com',
        messagingSenderId: '110453299973',
        appId: '1:110453299973:web:7365e49199380b425cf56c',
        measurementId: 'G-1B06YPGQ62',
      };

      const app = initializeApp(firebaseConfig);
      const analytics = getAnalytics(app);
      const perf = getPerformance(app);

    script(type='module', src='js/application.js')
