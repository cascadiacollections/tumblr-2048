# Ensure consistent line endings
* text=auto eol=lf

# Source files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.pug text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Scripts
*.sh text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary

# Documents
*.pdf binary
